# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# 3D viewer build artifacts (regenerated by `make build`).
docs/3d-viewer/model.glb
docs/3d-viewer/textures/
docs/3d-viewer/components.json
docs/3d-viewer/docs.html
# Python bytecode caches anywhere in the tree (FreeCAD writes them next to the
# script it runs, so they appear at the repo root too).
__pycache__/

# Python venv (we're on uv now)
.venv-3d/
.venv/

# WRL fix backups
daisy-studio.pretty/SDS-50J.original.stp
daisy-studio.pretty/SDS-50J.stp.disabled

# Firmware build artifacts (per-project, regenerated by `make` in firmware/)
firmware/projects/*/build/
